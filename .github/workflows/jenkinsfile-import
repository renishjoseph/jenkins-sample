pipeline {
    agent {
        docker {
            label 'my-slave-node'
            image 'node:trixie'
            args '-u root'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Import to Ampliance Hub') {
            steps {
                sh '''#!/bin/bash
                set -e
                echo "Running import of ${CONTENT_ITEM} to ${ENVIRONMENT}"

                npm install -g @amplience/dc-cli

                CLI_ARGS="--hubId ${HUB_ID} --clientId ${CLIENT_ID} --clientSecret ${CLIENT_SECRET}"

                run_import () {
                  local TYPE=$1
                  local DIRECTORY=$2
                  echo "Importing ${TYPE}"
                  dc-cli "${TYPE}" import "${DIRECTORY}" ${CLI_ARGS}
                }

                case "${CONTENT_ITEM}" in
                  all)
                    run_import "content-type-schema" "./content/content-type-schemas"
                    run_import "content-type" "./content/content-types"
                    run_import "extension" "./extensions"
                    ;;
                  content-type-schemas)
                    run_import "content-type-schema" "./content/${CONTENT_ITEM}"
                    ;;
                  content-types)
                    run_import "content-type" "./content/${CONTENT_ITEM}"
                    ;;
                  extensions)
                    run_import "extension" "./${CONTENT_ITEM}"
                    ;;
                  *)
                    echo "Invalid input: ${CONTENT_ITEM}"
                    exit 1
                    ;;
                esac
                '''
            }
        }
    }
}
